import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

class BarometrischesPhasenModell:
    """
    Modelliert das p-T-Phasendiagramm von H2O (Siedekurve) mittels der
    Clausius-Clapeyron-Gleichung und vergleicht es mit dem eindimensionalen
    Wunsch-Framing der Psychologie.
    """
    def __init__(self):
        # Universelle Gaskonstante und Verdampfungsenthalpie fuer Wasser
        self.R = 8.314  # J/(mol*K)
        self.Delta_H_vap = 40650  # J/mol (Verdampfungsenthalpie)
        self.T_ref = 373.15  # Referenztemperatur (100 °C in Kelvin)
        self.p_ref = 101325  # Referenzdruck (1 atm = 1013.25 hPa)

    def berechne_siedetemperatur(self, p_pascal: np.ndarray) -> np.ndarray:
        """
        Berechnet die Siedetemperatur in Celsius fuer einen gegebenen Druck p
        unter Verwendung der integrierten Clausius-Clapeyron-Gleichung.
        """
        # 1/T = 1/T_ref - (R / Delta_H_vap) * ln(p / p_ref)
        inv_T = (1.0 / self.T_ref) - (self.R / self.Delta_H_vap) * np.log(p_pascal / self.p_ref)
        T_kelvin = 1.0 / inv_T
        return T_kelvin - 273.15  # Umrechnung in °C

# Instanziierung des physikalischen Modells
modell_phase = BarometrischesPhasenModell()

# Druckbereiche simulieren (von fast Vakuum bis Ueberdruck, in Pascal)
druck_spektrum = np.logspace(1.5, 6.0, 500)  # 31 Pa bis 1 MPa
siede_temp = modell_phase.berechne_siedetemperatur(druck_spektrum)

# Reale Umgebungen (Referenzpunkte)
