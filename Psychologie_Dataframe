from dataclasses import dataclass, field
from typing import List, Optional

@dataclass
class LehrbuchZitat:
    text: str
    seite: int
    quelle: str

@dataclass
class Teilgebiet:
    name: str
    beschreibung: str

@dataclass
class KritikPunkt:
    kategorie: str
    titel: str
    argumentation: str

@dataclass
class KontrollMechanismus:
    instanz: str
    funktion: str
    status: str

@dataclass
class SystemischeBruchlinie:
    titel: str
    beschreibung: str
    verfassungs_bezug: str

@dataclass
class VerwaltungsRealitaet:
    stelle: str
    behoerde: str
    mindestqualifikation: str
    aufgaben: List[str]
    kontrollen: List[KontrollMechanismus] = field(default_factory=list)
    bruchlinien: List[SystemischeBruchlinie] = field(default_factory=list)

@dataclass
class LehrbuchStruktur:
    titel_de: str
    titel_orig: str
    erstveroeffentlichung_jahr: int
    autoren: List[str]
    teilgebiete: List[Teilgebiet] = field(default_factory=list)
    zitate: List[LehrbuchZitat] = field(default_factory=list)
    kritik: List[KritikPunkt] = field(default_factory=list)
    praxis_beispiele: List[VerwaltungsRealitaet] = field(default_factory=list)

